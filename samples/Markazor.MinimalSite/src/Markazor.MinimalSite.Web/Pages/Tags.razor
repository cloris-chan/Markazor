@page "/tags"
@page "/tags/{Value}"
@page "/tags/{Value}/page/{Number:int}"
@using Markazor.Reading

<ReaderPage Kind="MarkazorReaderPageKind.Tags" Value="@Value" PageNumber="Number" />

@code {
    [Parameter]
    public string? Value { get; set; }
    [Parameter]
    public int Number { get; set; } = 1;
}
