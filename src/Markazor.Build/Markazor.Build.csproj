<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Markazor.Build.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="HtmlSanitizer" />
    <EmbeddedResource Include="..\Markazor\assets\markdown-profile.json" LogicalName="Markazor.MarkdownProfile.json" />
    <ProjectReference Include="..\Markazor\Markazor.csproj" />
    <None Include="..\Markazor\obj\$(Configuration)\net10.0\markazor-editor\render-markdown.cjs;..\Markazor\obj\$(Configuration)\net10.0\markazor-editor\render-markdown.cjs.LEGAL.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
