@page "/categories"
@page "/categories/{Value}"
@page "/categories/{Value}/page/{Number:int}"
@using Markazor.Reading

<ReaderPage Kind="MarkazorReaderPageKind.Categories" Value="@Value" PageNumber="Number" />

@code {
    [Parameter]
    public string? Value { get; set; }
    [Parameter]
    public int Number { get; set; } = 1;
}
