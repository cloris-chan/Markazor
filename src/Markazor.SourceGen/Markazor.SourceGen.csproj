<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Markazor.SourceGen</PackageId>
    <Description>Source generator for Markazor content indexes.</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Markazor\Content\MarkdownFrontMatter.cs" Link="Content\MarkdownFrontMatter.cs" />
    <Compile Include="..\Markazor.Core\Setup\MarkazorSiteSettings.Data.cs" Link="Setup\MarkazorSiteSettings.Data.cs" />
    <Compile Include="..\Markazor.Core\Setup\MarkazorSiteSettingsJson.cs" Link="Setup\MarkazorSiteSettingsJson.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)*.dll"
          Exclude="$(OutputPath)Microsoft.CodeAnalysis*.dll;$(OutputPath)System.Collections.Immutable.dll;$(OutputPath)System.Reflection.Metadata.dll;$(OutputPath)System.Text.Encoding.CodePages.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
