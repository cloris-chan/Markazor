@inject IJSRuntime JavaScript
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable

<HeadContent><link rel="stylesheet" href="./_content/Markazor/markazor-markdown-editor.css" /></HeadContent>

<div class="markazor-markdown-editor" @ref="rootElement">
    <div class="markazor-markdown-toolbar" role="toolbar" aria-label="Markdown tools" @onmousedown:preventDefault>
        <span class="markazor-markdown-tool-group">
            <button type="button" title="Undo" aria-label="Undo" @onclick='() => FormatAsync("undo")' disabled="@ToolbarDisabled">Undo</button>
            <button type="button" title="Redo" aria-label="Redo" @onclick='() => FormatAsync("redo")' disabled="@ToolbarDisabled">Redo</button>
        </span>
        <span class="markazor-markdown-tool-group">
            <button type="button" title="Heading 2" aria-label="Heading 2" @onclick='() => FormatAsync("heading2")' disabled="@ToolbarDisabled">H2</button>
        </span>
        <span class="markazor-markdown-tool-group">
            <button type="button" title="Bold" aria-label="Bold" @onclick='() => FormatAsync("bold")' disabled="@ToolbarDisabled"><strong>B</strong></button>
            <button type="button" title="Italic" aria-label="Italic" @onclick='() => FormatAsync("italic")' disabled="@ToolbarDisabled"><em>I</em></button>
        </span>
        <span class="markazor-markdown-tool-group">
            <button type="button" title="Link" aria-label="Link" @onclick='() => FormatAsync("link")' disabled="@ToolbarDisabled">Link</button>
            @if (UsesImageAssetToolbar)
            {
                <span class="markazor-markdown-image-menu">
                    <button type="button"
                            class="markazor-markdown-menu-trigger"
                            title="Insert image"
                            aria-label="Insert image"
                            aria-haspopup="menu"
                            aria-expanded="@imageMenuOpen"
                            @onclick="ToggleImageMenu"
                            disabled="@ImageToolbarDisabled">Image</button>
                    @if (imageMenuOpen)
                    {
                        <button type="button"
                                class="markazor-markdown-menu-backdrop"
                                aria-label="Close image menu"
                                @onclick="CloseImageMenu"></button>
                        <span class="markazor-markdown-image-menu-panel" role="menu" aria-label="Image source">
                            @if (ExternalImageRequested.HasDelegate)
                            {
                                <button type="button" role="menuitem" @onclick="RequestExternalImageAsync">From URL</button>
                            }
                            @if (ImageUploadRequested.HasDelegate)
                            {
                                <label class="@UploadButtonClass" role="menuitem" title="Upload local image" aria-label="Upload local image">
                                    <span>Upload local image</span>
                                    <InputFile OnChange="RequestImageUploadAsync"
                                               accept="@AcceptedImageTypes"
                                               disabled="@ImageToolbarDisabled" />
                                </label>
                            }
                        </span>
                    }
                </span>
            }
            else
            {
                <button type="button" title="Image" aria-label="Image" @onclick='() => FormatAsync("image")' disabled="@ToolbarDisabled">Img</button>
            }
        </span>
        <span class="markazor-markdown-tool-group">
            <button type="button" title="Bulleted list" aria-label="Bulleted list" @onclick='() => FormatAsync("unordered-list")' disabled="@ToolbarDisabled">List</button>
        </span>
        <details class="markazor-editor-more">
            <summary>More</summary>
            <div class="markazor-editor-more-tools">
                <button type="button" @onclick='() => FormatAsync("heading3")' disabled="@ToolbarDisabled">Heading 3</button>
                <button type="button" @onclick='() => FormatAsync("code")' disabled="@ToolbarDisabled">Inline code</button>
                <button type="button" @onclick='() => FormatAsync("ordered-list")' disabled="@ToolbarDisabled">Numbered list</button>
                <button type="button" @onclick='() => FormatAsync("quote")' disabled="@ToolbarDisabled">Quote</button>
                <button type="button" @onclick='() => FormatAsync("divider")' disabled="@ToolbarDisabled">Divider</button>
                <button type="button" @onclick='() => FormatAsync("table")' disabled="@ToolbarDisabled">Table</button>
                <button type="button" @onclick='() => FormatAsync("code-block")' disabled="@ToolbarDisabled">Code block</button>
            </div>
        </details>
        <span class="markazor-markdown-tool-group">
            <button type="button" title="Find" aria-label="Find in article" @onclick="ToggleSearch" disabled="@ToolbarDisabled">Find</button>
        </span>
        @if (editorUnavailable)
        {
            <span class="markazor-markdown-toolbar-status">Formatting tools unavailable. You can still type.</span>
        }
        @if (PendingAssetCount > 0)
        {
            <span class="markazor-markdown-toolbar-status">@PendingAssetCount @(PendingAssetCount == 1 ? "image" : "images") to upload on save</span>
        }
    </div>
    @if (searchOpen)
    {
        <div class="markazor-editor-search" role="search" aria-label="Find in article">
            <input type="search" aria-label="Find text" value="@searchText" @oninput="SearchChangedAsync" />
            <button type="button" @onclick='() => SearchAsync("previous")'>Previous</button>
            <button type="button" @onclick='() => SearchAsync("next")'>Next</button>
            <button type="button" @onclick="CloseSearchAsync">Close</button>
        </div>
    }
    @if (editorError is not null)
    {
        <p class="markazor-error" role="alert">@editorError</p>
    }
    <div class="markazor-muya-host" role="region" aria-label="Article body" @ref="hostElement"></div>
    <textarea class="markazor-editor-textarea markazor-markdown-editor-fallback"
              aria-label="Markdown text"
              value="@Value"
              @oninput="OnFallbackInputAsync"
              disabled="@Disabled"
              spellcheck="true"></textarea>
</div>

@code {
    private readonly string editorId = "markazor-editor-" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MarkazorMarkdownEditor>? dotNetReference;
    private ElementReference rootElement;
    private ElementReference hostElement;
    private IJSObjectReference? module;
    private bool initialized;
    private bool isEditorReady;
    private bool editorUnavailable;
    private bool lastDisabled;
    private bool imageMenuOpen;
    private bool searchOpen;
    private string searchText = string.Empty;
    private string? editorError;
    private Dictionary<string, string> lastImageSources = [];
    private string lastValue = string.Empty;
    private string? lastDocumentKey;

    private bool ToolbarDisabled => Disabled || !isEditorReady;
    private bool ImageToolbarDisabled => Disabled;
    private bool UsesImageAssetToolbar => ExternalImageRequested.HasDelegate || ImageUploadRequested.HasDelegate;
    private string UploadButtonClass => ImageToolbarDisabled ? "markazor-markdown-upload-button is-disabled" : "markazor-markdown-upload-button";

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? DocumentKey { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback SaveRequested { get; set; }

    [Parameter]
    public EventCallback ExternalImageRequested { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> ImageUploadRequested { get; set; }

    [Parameter]
    public string AcceptedImageTypes { get; set; } = string.Empty;

    [Parameter]
    public int PendingAssetCount { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, string> ImageSources { get; set; } = new Dictionary<string, string>();

    [Parameter]
    public long MaxImageBytes { get; set; } = 8L * 1024 * 1024;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!initialized)
        {
            await InitializeEditorAsync().ConfigureAwait(false);
            return;
        }

        await SynchronizeEditorAsync().ConfigureAwait(false);
    }

    private async Task InitializeEditorAsync()
    {
        try
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Markazor/markazor-markdown-editor.js").ConfigureAwait(false);
            if (module is null)
            {
                initialized = true;
                editorUnavailable = true;
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
                return;
            }

            dotNetReference = DotNetObjectReference.Create(this);
            lastValue = Value ?? string.Empty;
            lastDocumentKey = DocumentKey;
            lastDisabled = Disabled;

            await module.InvokeVoidAsync(
                "initialize",
                editorId,
                rootElement,
                hostElement,
                dotNetReference,
                lastValue,
                lastDisabled,
                ImageSources,
                new Dictionary<string, object?>
                {
                    ["enabled"] = ImageUploadRequested.HasDelegate,
                    ["maxBytes"] = MaxImageBytes,
                    ["documentKey"] = DocumentKey,
                }).ConfigureAwait(false);
            lastImageSources = new Dictionary<string, string>(ImageSources, StringComparer.Ordinal);

            initialized = true;
            isEditorReady = true;
            editorUnavailable = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
            initialized = true;
            isEditorReady = false;
            editorUnavailable = true;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    private async Task SynchronizeEditorAsync()
    {
        if (module is null)
        {
            return;
        }

        string currentValue = Value ?? string.Empty;
        if (!string.Equals(currentValue, lastValue, StringComparison.Ordinal) || !string.Equals(DocumentKey, lastDocumentKey, StringComparison.Ordinal))
        {
            lastValue = currentValue;
            lastDocumentKey = DocumentKey;
            await module.InvokeVoidAsync("setValue", editorId, currentValue, ImageSources, DocumentKey).ConfigureAwait(false);
            lastImageSources = new Dictionary<string, string>(ImageSources, StringComparer.Ordinal);
        }

        if (lastImageSources.Count != ImageSources.Count || ImageSources.Any(pair => !lastImageSources.TryGetValue(pair.Key, out string? value) || !string.Equals(pair.Value, value, StringComparison.Ordinal)))
        {
            await module.InvokeVoidAsync("setImageSources", editorId, ImageSources).ConfigureAwait(false);
            lastImageSources = new Dictionary<string, string>(ImageSources, StringComparer.Ordinal);
        }

        if (Disabled != lastDisabled)
        {
            lastDisabled = Disabled;
            await module.InvokeVoidAsync("setDisabled", editorId, Disabled).ConfigureAwait(false);
        }
    }

    private async Task OnFallbackInputAsync(ChangeEventArgs args)
    {
        string value = args.Value?.ToString() ?? string.Empty;
        lastValue = value;
        await ValueChanged.InvokeAsync(value).ConfigureAwait(false);
    }

    private async Task FormatAsync(string command)
    {
        if (Disabled || module is null || !isEditorReady)
        {
            return;
        }

        await module.InvokeVoidAsync("format", editorId, command).ConfigureAwait(false);
    }

    private void ToggleImageMenu()
    {
        if (!ImageToolbarDisabled)
        {
            imageMenuOpen = !imageMenuOpen;
        }
    }

    private void CloseImageMenu()
    {
        imageMenuOpen = false;
    }

    private async Task RequestExternalImageAsync()
    {
        if (!ImageToolbarDisabled && ExternalImageRequested.HasDelegate)
        {
            imageMenuOpen = false;
            await ExternalImageRequested.InvokeAsync().ConfigureAwait(false);
        }
    }

    private async Task RequestImageUploadAsync(InputFileChangeEventArgs args)
    {
        if (!ImageToolbarDisabled && ImageUploadRequested.HasDelegate)
        {
            imageMenuOpen = false;
            await ImageUploadRequested.InvokeAsync(args).ConfigureAwait(false);
        }
    }

    public async Task InsertMarkdownAsync(string markdown, IReadOnlyDictionary<string, string>? imageSources = null)
    {
        ArgumentNullException.ThrowIfNull(markdown);

        if (Disabled)
        {
            return;
        }

        if (module is not null && isEditorReady)
        {
            await module.InvokeVoidAsync("insertText", editorId, markdown, imageSources ?? ImageSources).ConfigureAwait(false);

            return;
        }

        string nextValue = (Value ?? string.Empty) + markdown;
        lastValue = nextValue;
        await ValueChanged.InvokeAsync(nextValue).ConfigureAwait(false);
    }

    [JSInvokable]
    public async Task NotifyEditorChanged(string value, string? documentKey = null)
    {
        if (!string.Equals(documentKey, DocumentKey, StringComparison.Ordinal))
        {
            return;
        }
        editorError = null;
        lastValue = value;
        await ValueChanged.InvokeAsync(value).ConfigureAwait(false);
    }

    [JSInvokable]
    public async Task NotifySaveRequested()
    {
        if (!Disabled)
        {
            await SaveRequested.InvokeAsync().ConfigureAwait(false);
        }
    }

    public async Task FlushAsync()
    {
        if (module is null || !isEditorReady)
        {
            return;
        }

        string? value = await module.InvokeAsync<string?>("getValue", editorId).ConfigureAwait(false);
        if (value is not null && !string.Equals(value, lastValue, StringComparison.Ordinal))
        {
            lastValue = value;
            await ValueChanged.InvokeAsync(value).ConfigureAwait(false);
        }
    }

    [JSInvokable]
    public async Task NotifyImageFile(string name, string contentType, byte[] content, string? documentKey = null)
    {
        ArgumentNullException.ThrowIfNull(content);
        if (Disabled || !ImageUploadRequested.HasDelegate || !string.Equals(documentKey, DocumentKey, StringComparison.Ordinal))
        {
            return;
        }

        if (content.LongLength > MaxImageBytes)
        {
            await NotifyEditorError("Image uploads are limited to 8 MB.").ConfigureAwait(false);
            return;
        }

        await ImageUploadRequested.InvokeAsync(new InputFileChangeEventArgs([new PastedImageFile(name, contentType, content)])).ConfigureAwait(false);
    }

    [JSInvokable]
    public Task NotifyEditorError(string message)
    {
        editorError = message;
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleSearch() => searchOpen = !searchOpen;

    private async Task SearchChangedAsync(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        await SearchAsync(null).ConfigureAwait(false);
    }

    private async Task SearchAsync(string? direction)
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("search", editorId, searchText, direction).ConfigureAwait(false);
        }
    }

    private async Task CloseSearchAsync()
    {
        searchOpen = false;
        searchText = string.Empty;
        await SearchAsync(null).ConfigureAwait(false);
    }

    private sealed class PastedImageFile(string name, string contentType, byte[] content) : IBrowserFile
    {
        public string Name => name;
        public string ContentType => contentType;
        public long Size => content.LongLength;
        public DateTimeOffset LastModified => DateTimeOffset.UtcNow;

        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default)
        {
            cancellationToken.ThrowIfCancellationRequested();
            if (Size > maxAllowedSize)
            {
                throw new IOException("Image exceeds the allowed upload size.");
            }

            return new MemoryStream(content, writable: false);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("dispose", editorId).ConfigureAwait(false);
            await module.DisposeAsync().ConfigureAwait(false);
        }

        dotNetReference?.Dispose();
    }
}
