@using System.Globalization
@inject IMarkazorReaderService Reader

<PageTitle>@Reader.Site.Name</PageTitle>

<section class="reader-intro" aria-labelledby="journal-title">
    <div class="reader-intro-copy">
        <p class="reader-eyebrow"><span class="reader-live-dot" aria-hidden="true"></span> The journal</p>
        <h1 id="journal-title">@Reader.Site.Name<span class="reader-title-period" aria-hidden="true">.</span></h1>
        <p class="reader-intro-description">@Reader.Site.Description</p>
        <a class="reader-intro-link" href="#latest-writing">Find something to read <MarkazorIcon Kind="MarkazorIconKind.ArrowDown" /></a>
    </div>
    <aside class="reader-colophon" aria-label="Explore the journal">
        <MarkazorIcon Kind="MarkazorIconKind.Book" Class="reader-colophon-mark" />
        <p class="reader-colophon-label">A work in progress</p>
        <p class="reader-colophon-title">Ideas<br />live here.</p>
        <nav class="reader-colophon-index" aria-label="Content types">
            <a href="/posts"><span>Posts <small>@postCount.ToString("D2", CultureInfo.InvariantCulture)</small></span><MarkazorIcon Kind="MarkazorIconKind.ArrowUpRight" /></a>
            <a href="/notes"><span>Notes <small>@noteCount.ToString("D2", CultureInfo.InvariantCulture)</small></span><MarkazorIcon Kind="MarkazorIconKind.ArrowUpRight" /></a>
        </nav>
    </aside>
</section>

<section class="reader-feed" id="latest-writing" aria-labelledby="latest-writing-title" tabindex="-1">
    <header class="reader-feed-heading">
        <div>
            <p class="reader-eyebrow">The latest</p>
            <h2 id="latest-writing-title">Fresh off the page<MarkazorIcon Kind="MarkazorIconKind.ArrowDownLeft" /></h2>
        </div>
        <a href="/archive">All writing <MarkazorIcon Kind="MarkazorIconKind.ArrowUpRight" /></a>
    </header>
    <ArticleList Page="articlePage" AriaLabel="Latest writing" PageLinkFactory="CreatePageLink" />
</section>

@code {
    [Parameter]
    public int Page { get; set; } = 1;

    private MarkazorArticlePage articlePage = default!;
    private int postCount;
    private int noteCount;

    protected override void OnInitialized()
    {
        postCount = Reader.GetPosts().TotalItems;
        noteCount = Reader.GetNotes().TotalItems;
    }

    protected override void OnParametersSet() => articlePage = Reader.GetArticles(Page);

    private static string CreatePageLink(int page) => MarkazorReaderRoutes.Page("/", page);
}
